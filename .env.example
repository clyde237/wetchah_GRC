# Copier en .env et remplir. Ce fichier-ci ne contient aucun secret réel.
#
# Générer une clé :  python3 -c "import secrets; print(secrets.token_hex(32))"
# 32 caractères minimum. Une clé par établissement, jamais partagée :
# elle signe les jetons d'accès administrateur du module GRC.
SECRET_KEY=

PORT=8085
DATABASE_URL=sqlite:////data/grc.db
TENANT_SLUG=demo
TENANT_NAME="Villa Boutanga"
ERP_API_URL=http://localhost:8001

# Jeton de service de l'API de reporting du PMS, tel que configuré côté
# wetchah_erp. Laisser vide désactive proprement le flux financier : le
# tableau de bord affiche « indisponible » au lieu d'inventer des chiffres.
REPORTING_SECRET=
